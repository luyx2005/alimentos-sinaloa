# Copia este archivo a .env y ajusta los valores.

# Cadena de conexión de PostgreSQL (también requerida en Vercel).
DATABASE_URL="postgresql://alimentos:alimentos@127.0.0.1:5432/alimentos_sinaloa"

# Cadena aleatoria para firmar las sesiones (mínimo 16 caracteres; también en Vercel).
AUTH_SECRET="cambia-esta-cadena-por-una-aleatoria"

# Carpeta de las fotos de las capturas (por omisión ./uploads).
UPLOADS_DIR="./uploads"
